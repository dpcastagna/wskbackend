@apiUrl = http://127.0.0.1:3000/api/v1

### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/41

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "name": "Tikru",
    "weight": 13,
    "owner": 45,
    "filename": "https://placecats.com/300/200",
    "birthdate": "2022-09-09"
}

### edit existing cat
PUT {{apiUrl}}/cats/56
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "weight": 9,
    "owner": 49
}

### delete cat by id
DELETE {{apiUrl}}/cats/47
Authorization: Bearer {{login.response.body.token}}

### post new cat from a form
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{login.response.body.token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Mosa
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

49
--MyBoundary
Content-Disposition: form-data; name="image"; filename="dog.jpg"
Content-Type: image/jpeg

< ./dog.jpg
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary--

### post new cat with no body FAIL
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{login.response.body.token}}


### post new cat from a form FAIL
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{login.response.body.token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Mosa
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

49
--MyBoundary
Content-Disposition: form-data; name="image"; filename="dog.jpg"
Content-Type: application/pdf

< ./dog.jpg
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary--

### get users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/1

### get user by id (FAIL: not found)
GET {{apiUrl}}/users/98

### post new admin
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "ad min",
    "username": "admin3",
    "email": "mervi@metropolia.fi",
    "role": "admin",
    "password": "admin2"
}

### post new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Maija Meikalainen",
    "username": "maijamei",
    "email": "maijam@metropolia.fi",
    "role": "user",
    "password": "maijamei"
}

### edit existing user
PUT {{apiUrl}}/users/49
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "name": "admin2",
    "email": "admin2@suomi.fi"
}

### delete user by id
DELETE {{apiUrl}}/users/46

### get cats by userid
GET {{apiUrl}}/users/catsownedbyuser/49

### Post login
# @name login
POST http://localhost:3000/api/v1/auth/login
content-type: application/json

{
  "username": "maijamei",
  "password": "maijamei"
}

### Get my user info
GET http://localhost:3000/api/v1/auth/me
Authorization: Bearer {{login.response.body.token}}
