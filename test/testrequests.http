@apiUrl = http://127.0.0.1:3000/api/v1

### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/1

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "name": "Tikru",
    "birthdate": "2022-09-09",
    "weight": 13,
    "owner": "Nalle Puh",
    "image": "https://placecats.com/300/200"
}

### edit existing cat
PUT {{apiUrl}}/cats/3
Content-Type: application/json

{
    "weight": 6,
    "owner": "Uusi omistaja"
}

### delete cat by id
DELETE {{apiUrl}}/cats/3
